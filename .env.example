# 复制本文件为 .env 并填入真实值；.env 已被 gitignore，不会提交
# LLM 采用 OpenAI 兼容协议，DeepSeek / 通义千问 / 智谱通用

LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-你的key
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=60
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# MySQL 连接（评测数据放专用库 db_doctor）
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=你的密码
MYSQL_DATABASE=db_doctor
